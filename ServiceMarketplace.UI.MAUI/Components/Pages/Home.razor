@page "/"
@using Microsoft.AspNetCore.Components
@inject NavigationManager Nav

<div class="container py-4">
    <h1 class="mb-4">Service Marketplace</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="GoToLogin">Login</button>
        <button class="btn btn-outline-primary" @onclick="GoToRegister">Register</button>
    </div>
</div>

@code {
    private void GoToLogin() => Nav.NavigateTo("/login");
    private void GoToRegister() => Nav.NavigateTo("/register");
}
