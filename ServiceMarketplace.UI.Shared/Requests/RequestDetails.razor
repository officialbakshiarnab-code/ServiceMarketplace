@page "/provider/requests/{RequestId:guid}"
@using ServiceMarketplace.Application.DTOs
@using ServiceMarketplace.UI.Shared.Requests
@inject RequestsApiClient RequestsClient
@inject NavigationManager Nav

<div class="container py-4">
    <button class="btn btn-link px-0" @onclick="GoBack">Back</button>

    <div class="card">
        <div class="card-body">
            @if (_loading)
            {
                <p class="text-muted mb-0">Loading...</p>
            }
            else if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }
            else if (_request is null)
            {
                <p class="mb-0">Request not found in current search radius.</p>
            }
            else
            {
                <h3 class="mb-2">@_request.Title</h3>
                <p class="text-muted">@_request.Description</p>

                <div class="row g-2">
                    <div class="col-12 col-md-6"><strong>Distance:</strong> @_request.DistanceKm.ToString("0.00") km</div>
                    <div class="col-12 col-md-6"><strong>Location:</strong> @_request.Latitude, @_request.Longitude</div>
                </div>

                <PlaceBid ServiceRequestId="RequestId" />
            }
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid RequestId { get; set; }

    private readonly NearbySearchDto _search = new() { Latitude = 0, Longitude = 0, RadiusKm = 50 };
    private bool _loading = true;
    private string? _error;
    private ServiceRequestDto? _request;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var results = await RequestsClient.NearbyAsync(_search);
            _request = results.FirstOrDefault(r => r.Id == RequestId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/provider/dashboard");
}