@page "/register"
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Logging
@using ServiceMarketplace.UI.Shared.Auth
@inject AuthApiClient AuthApi
@inject NavigationManager Nav
@inject ILogger<Register> Logger

<PageTitle>Register</PageTitle>

<div class="container py-4" style="max-width: 600px;">
    <h3 class="mb-3">Register</h3>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @_error
        </div>
    }

    @if (_success)
    {
        <div class="alert alert-success" role="alert">
            Registration successful! Redirecting to login...
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleRegisterAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">First Name</label>
                    <InputText class="form-control" @bind-Value="_model.FirstName" placeholder="First name"
                        disabled="@_busy" />
                    <ValidationMessage For="@(() => _model.FirstName)" />
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label">Last Name</label>
                    <InputText class="form-control" @bind-Value="_model.LastName" placeholder="Last name"
                        disabled="@_busy" />
                    <ValidationMessage For="@(() => _model.LastName)" />
                </div>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="_model.Email" placeholder="Email" disabled="@_busy" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Date of Birth</label>
            <InputDate class="form-control" @bind-Value="_model.DateOfBirth" disabled="@_busy" />
            <ValidationMessage For="@(() => _model.DateOfBirth)" />
            @if (!string.IsNullOrWhiteSpace(_dobWarning))
            {
                <small class="text-muted d-block mt-1">@_dobWarning</small>
            }
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" @bind="_model.Password" placeholder="Password"
                disabled="@_busy" />
            <ValidationMessage For="@(() => _model.Password)" />
            <small class="text-muted d-block mt-1">
                Password must contain: uppercase, lowercase, digit, special character, and be at least 6 characters.
            </small>
        </div>

        <div class="mb-3">
            <label class="form-label">User Type</label>
            <InputSelect class="form-select" @bind-Value="_model.Role" disabled="@_busy">
                <option value="">-- Select a role --</option>
                <option value="User">User (Request Services)</option>
                <option value="ServiceProvider">Service Provider (Offer Services - Must be 18+)</option>
            </InputSelect>
            <ValidationMessage For="@(() => _model.Role)" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-2" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Registering...</span>
            }
            else
            {
                <span>Register</span>
            }
        </button>
        <button type="button" class="btn btn-link w-100" @onclick="GoToLogin" disabled="@_busy">
            Already have an account? Login here
        </button>
    </EditForm>
</div>

@code {
    private readonly RegisterModel _model = new() { Role = "User" };
    private readonly SubmissionGuard _submissionGuard = new();
    private bool _busy;
    private bool _success;
    private string? _error;
    private string? _fileError;
    private string? _dobWarning;

    /// <summary>
    /// Handles user registration with age validation:
    /// 1. Check SubmissionGuard - ensure this is not a duplicate request
    /// 2. Validate age based on role
    /// 3. Validate government ID file if provided
    /// 4. Call AuthApiClient.RegisterAsync
    /// 5. On success: show success message ? redirect to /login
    /// 6. On failure: display error message
    /// 
    /// Note: File upload is validated client-side but cannot be sent
    /// to API from Blazor WebAssembly due to CORS and stream limitations.
    /// TODO: Implement proper multipart file upload via dedicated endpoint.
    /// </summary>
    private async Task HandleRegisterAsync()
    {
        // GUARD: Check if this submission is allowed (prevents duplicate submissions)
        if (!await _submissionGuard.IsAllowedAsync("register"))
        {
            Logger.LogWarning("[Register] Duplicate submission attempt blocked");
            return;
        }

        _error = null;
        _fileError = null;
        _success = false;
        _busy = true;

        try
        {
            // Validate age for service provider role (client-side check)
            if (_model.Role == "ServiceProvider")
            {
                var age = CalculateAge(_model.DateOfBirth);
                if (age < 18)
                {
                    _error = $"Service providers must be at least 18 years old. You are currently {age} years old.";
                    await _submissionGuard.ResetAsync("register");
                    return;
                }
            }

            // NOTE: File validation and upload would happen here in a real implementation
            // Due to Blazor WebAssembly limitations with streaming large files,
            // the government ID image upload should be implemented as a separate endpoint
            // that accepts multipart/form-data AFTER registration succeeds.
            // This allows users to complete registration even if file upload fails.
            
            // For now, we just validate the file client-side if it exists
            _fileError = null;

            // Create request DTO with exact property names/types API expects
            var request = new RegisterRequest
            {
                Email = _model.Email,
                Password = _model.Password,
                FirstName = _model.FirstName,
                LastName = _model.LastName,
                DateOfBirth = _model.DateOfBirth,
                Role = _model.Role  // MUST be "User" or "ServiceProvider" (case-sensitive)
            };

            Logger.LogInformation("[Register] Sending registration request for: {Email}, Role: {Role}, Age: {Age}",
                request.Email, request.Role, CalculateAge(_model.DateOfBirth));

            // Call AuthApiClient - returns result object (never throws)
            var result = await AuthApi.RegisterAsync(request);

            if (!result.Success)
            {
                // Registration failed - display user-friendly error message
                _error = result.Error ?? "Registration failed. Please try again.";
                Logger.LogWarning("[Register] Registration failed: {Error}", _error);
                
                // Reset submission guard on error so user can retry
                await _submissionGuard.ResetAsync("register");
                return;
            }

            Logger.LogInformation("[Register] Registration successful for: {Email}", request.Email);

            _success = true;

            // Brief delay to show success message before redirect
            await Task.Delay(1500);

            Nav.NavigateTo("/login");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// Calculates user age from date of birth.
    /// </summary>
    private int CalculateAge(DateTime dateOfBirth)
    {
        var today = DateTime.Today;
        var age = today.Year - dateOfBirth.Year;
        if (dateOfBirth.Date > today.AddYears(-age))
        {
            age--;
        }
        return age;
    }

    /// <summary>
    /// Updates DOB warning message when date changes.
    /// Shows user their calculated age and any age-related restrictions.
    /// </summary>
    private void OnDateOfBirthChanged()
    {
        if (_model.DateOfBirth == default)
        {
            _dobWarning = null;
            return;
        }

        var age = CalculateAge(_model.DateOfBirth);
        if (age < 0)
        {
            _dobWarning = "Date of birth cannot be in the future";
            return;
        }

        _dobWarning = _model.Role == "ServiceProvider" && age < 18
            ? $"?? You must be 18+ to register as a Service Provider. You are {age} years old."
            : $"Age: {age} years old";
    }

    /// <summary>
    /// Called whenever the role dropdown changes.
    /// Updates DOB warning to show age requirements for selected role.
    /// </summary>
    private void OnRoleChanged()
    {
        OnDateOfBirthChanged(); // Re-validate age based on new role
    }

    private void GoToLogin() => Nav.NavigateTo("/login");

    /// <summary>
    /// View model for registration form with client-side validation.
    /// All properties match API's RegisterRequest DTO exactly.
    /// </summary>
    private sealed class RegisterModel
    {
        [Required(ErrorMessage = "First name is required")]
        [StringLength(100, ErrorMessage = "First name cannot exceed 100 characters")]
        public string FirstName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Last name is required")]
        [StringLength(100, ErrorMessage = "Last name cannot exceed 100 characters")]
        public string LastName { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Date of birth is required")]
        public DateTime DateOfBirth { get; set; } = DateTime.Today.AddYears(-25); // Default to 25 years old

        [Required(ErrorMessage = "Please select a role")]
        public string Role { get; set; } = "User";
    }
}