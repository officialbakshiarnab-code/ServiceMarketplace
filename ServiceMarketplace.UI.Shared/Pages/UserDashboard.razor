@page "/user/dashboard"
@using ServiceMarketplace.UI.Shared.Auth
@inject NavigationManager Nav
@inject AuthState AuthState
@inject AuthRedirector Redirector

@code {
    private bool _isAuthenticated;
    private string? _role;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthState.IsAuthenticatedAsync();
        _role = await AuthState.GetRoleAsync();

        Console.WriteLine($"[UserDashboard] Auth: {_isAuthenticated}, Role: {_role}");

        if (!_isAuthenticated)
        {
            Console.WriteLine("[UserDashboard] Not authenticated, redirecting to login");
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        // WHY: If user has ServiceProvider role, redirect them to provider dashboard
        if (string.Equals(_role, "ServiceProvider", StringComparison.Ordinal))
        {
            Console.WriteLine("[UserDashboard] ServiceProvider detected, redirecting");
            await Redirector.RedirectToDashboardAsync();
        }
    }
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User Dashboard</h2>
        <LogoutButton />
    </div>

    <AuthorizeView Roles="User">
        <Authorized>
            <div class="alert alert-info" role="alert">
                <strong>Welcome, User!</strong>
                <p class="mb-0">Features coming soon:</p>
                <ul class="mb-0">
                    <li>Create service requests</li>
                    <li>View your active requests</li>
                    <li>Manage bids from providers</li>
                </ul>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning" role="alert">Redirecting...</div>
        </NotAuthorized>
    </AuthorizeView>
</div>

