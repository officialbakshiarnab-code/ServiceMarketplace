@using ServiceMarketplace.Application.DTOs
@using ServiceMarketplace.Domain.Enums
@inject RequestsApiClient RequestsClient
@inject ServiceCatalogApiClient CatalogClient
@inject NavigationManager Nav

<div class="card">
    <div class="card-body">
        <h5 class="mb-3">Create Service Request</h5>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        <EditForm Model="_model" OnValidSubmit="SubmitAsync">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label">Title</label>
                <InputText class="form-control" @bind-Value="_model.Title" disabled="@_busy" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputTextArea class="form-control" rows="4" @bind-Value="_model.Description" disabled="@_busy" />
            </div>

            <div class="row g-2">
                <div class="col-12 col-md-6">
                    <label class="form-label">Category</label>
                    <InputSelect class="form-select" @bind-Value="_model.ServiceCategoryId" disabled="@(_busy || _categories.Count == 0)">
                        <option value="">Select a category</option>
                        @foreach (var category in _categories)
                        {
                            <option value="@category.Id">@category.Name</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Service Zone</label>
                    <InputSelect class="form-select" @bind-Value="_model.ServiceZoneId" disabled="@(_busy || _zones.Count == 0)">
                        <option value="">Select a zone</option>
                        @foreach (var zone in _zones)
                        {
                            <option value="@zone.Id">@zone.DisplayName</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="row g-2 mt-1">
                <div class="col-12 col-md-6">
                    <label class="form-label">Specific Category</label>
                    <InputText class="form-control" @bind-Value="_model.Category" disabled="@_busy" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Exact Location</label>
                    <InputText class="form-control" @bind-Value="_model.Location" disabled="@_busy" />
                </div>
            </div>

            <div class="row g-2 mt-1">
                <div class="col-12 col-md-6">
                    <label class="form-label">Urgency</label>
                    <InputSelect class="form-select" @bind-Value="_model.Urgency" disabled="@_busy">
                        <option value="@ServiceRequestUrgency.Flexible">Flexible</option>
                        <option value="@ServiceRequestUrgency.Soon">Soon</option>
                        <option value="@ServiceRequestUrgency.Urgent">Urgent</option>
                        <option value="@ServiceRequestUrgency.Emergency">Emergency</option>
                    </InputSelect>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">Preferred Start</label>
                    <InputDate class="form-control" @bind-Value="_model.PreferredStartAt" disabled="@_busy" />
                </div>
            </div>

            <div class="mt-3">
                <label class="form-label">Requirements</label>
                <InputTextArea class="form-control" rows="3" @bind-Value="_model.Requirements" disabled="@_busy" />
            </div>

            <div class="mt-3">
                <button class="btn btn-primary" type="submit" disabled="@_busy">
                    @if (_busy)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Submitting...</span>
                    }
                    else
                    {
                        <span>Submit Request</span>
                    }
                </button>
            </div>
        </EditForm>
    </div>
</div>

@code {
    private readonly CreateServiceRequestDto _model = new();
    private List<ServiceCategoryDto> _categories = [];
    private List<ServiceZoneDto> _zones = [];
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await CatalogClient.GetCategoriesAsync();
            _zones = await CatalogClient.GetZonesAsync();
        }
        catch
        {
            _categories = [];
            _zones = [];
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_model.Title) || string.IsNullOrWhiteSpace(_model.Description))
        {
            _error = "Title and description are required.";
            return;
        }

        if (_model.ServiceCategoryId == null && string.IsNullOrWhiteSpace(_model.Category))
        {
            _error = "Category is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_model.Location))
        {
            _error = "Location is required.";
            return;
        }

        _model.Latitude = 0;
        _model.Longitude = 0;

        _busy = true;
        try
        {
            await RequestsClient.CreateAsync(_model);
            Nav.NavigateTo("/user/my-requests");
        }
        catch (Exception ex)
        {
            _error = ErrorMessageFormatter.ToFriendlyMessage(ex, "Unable to create the request right now.");
        }
        finally
        {
            _busy = false;
        }
    }
}
