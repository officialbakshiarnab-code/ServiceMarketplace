@page "/user/dashboard"
@using ServiceMarketplace.Application.Constants
@using ServiceMarketplace.Application.DTOs
@using ServiceMarketplace.UI.Shared.Auth
@using ServiceMarketplace.UI.Shared.Requests
@inject NavigationManager Nav
@inject AuthState AuthState
@inject AuthRedirector Redirector
@inject RequestsApiClient RequestsClient
@inject ContactRequestsApiClient ContactClient

<PageTitle>User Dashboard</PageTitle>

<div class="container py-4 dashboard-page">
    <div class="dashboard-heading">
        <div>
            <h2>User Dashboard</h2>
            <p>Requests, service orders, profile discovery, and approved contact sharing.</p>
        </div>
    </div>

    @if (_loading)
    {
        <p class="text-muted">Loading dashboard...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-warning">@_error</div>
    }

    <section class="kpi-grid">
        <article class="kpi-card">
            <i class="bi bi-send-plus"></i>
            <span>Open Requests</span>
            <strong>@(_stats?.OpenRequestsCount ?? 0)</strong>
        </article>
        <article class="kpi-card">
            <i class="bi bi-hand-index-thumb"></i>
            <span>Active Bids</span>
            <strong>@(_stats?.ActiveBidsCount ?? 0)</strong>
        </article>
        <article class="kpi-card">
            <i class="bi bi-check2-circle"></i>
            <span>Completed</span>
            <strong>@(_stats?.CompletedRequestsCount ?? 0)</strong>
        </article>
        <article class="kpi-card">
            <i class="bi bi-person-vcard"></i>
            <span>Approved Contacts</span>
            <strong>@(_contactSummary?.ApprovedCount ?? 0)</strong>
        </article>
    </section>

    <section class="dashboard-layout">
        <div class="dashboard-panel">
            <div class="panel-title">
                <h3>Quick Actions</h3>
                <span>Customer workflow</span>
            </div>
            <div class="action-grid">
                <button class="action-tile primary" @onclick="GoToCreateRequest">
                    <i class="bi bi-plus-circle"></i>
                    <span>Create Request</span>
                </button>
                <button class="action-tile" @onclick="GoToMyRequests">
                    <i class="bi bi-list-check"></i>
                    <span>My Requests</span>
                </button>
                <button class="action-tile" @onclick="GoToServiceOrders">
                    <i class="bi bi-clipboard2-check"></i>
                    <span>Service Orders</span>
                </button>
                <button class="action-tile" @onclick="GoToProfiles">
                    <i class="bi bi-search"></i>
                    <span>Find Profiles</span>
                </button>
                <button class="action-tile" @onclick="GoToContactRequests">
                    <i class="bi bi-telephone-outbound"></i>
                    <span>Contact Requests</span>
                </button>
                <button class="action-tile" @onclick="GoToMarketplace">
                    <i class="bi bi-bag-check"></i>
                    <span>Marketplace</span>
                </button>
            </div>
        </div>

        <div class="dashboard-panel">
            <div class="panel-title">
                <h3>Request Distribution</h3>
                <span>CSS-only chart</span>
            </div>
            <DashboardBar Label="Open" Value="@(_stats?.OpenRequestsCount ?? 0)" Max="@MaxRequestValue" ClassName="blue" />
            <DashboardBar Label="Active bids" Value="@(_stats?.ActiveBidsCount ?? 0)" Max="@MaxRequestValue" ClassName="teal" />
            <DashboardBar Label="Completed" Value="@(_stats?.CompletedRequestsCount ?? 0)" Max="@MaxRequestValue" ClassName="green" />
            <DashboardBar Label="Total" Value="@(_stats?.TotalRequestsCount ?? 0)" Max="@MaxRequestValue" ClassName="slate" />
        </div>

        <div class="dashboard-panel">
            <div class="panel-title">
                <h3>Contact Sharing</h3>
                <span>Admin-approved privacy flow</span>
            </div>
            <DashboardBar Label="Pending" Value="@(_contactSummary?.PendingCount ?? 0)" Max="@MaxContactValue" ClassName="amber" />
            <DashboardBar Label="Approved" Value="@(_contactSummary?.ApprovedCount ?? 0)" Max="@MaxContactValue" ClassName="green" />
            <DashboardBar Label="Rejected" Value="@(_contactSummary?.RejectedCount ?? 0)" Max="@MaxContactValue" ClassName="red" />
            <DashboardBar Label="Callbacks" Value="@(_contactSummary?.CallbackPendingCount ?? 0)" Max="@MaxContactValue" ClassName="blue" />
        </div>

        <div class="dashboard-panel">
            <div class="panel-title">
                <h3>Recent Activity</h3>
                <span>Next best steps</span>
            </div>
            <ol class="timeline">
                <li>Use Profile Search to discover providers and sellers.</li>
                <li>Create a service request when you need competitive bids.</li>
                <li>Use Request Contact only when direct phone/email sharing is needed.</li>
            </ol>
        </div>
    </section>
</div>

@code {
    private bool _loading = true;
    private string? _error;
    private UserDashboardStatsDto? _stats;
    private ContactRequestSummaryDto? _contactSummary;

    private int MaxRequestValue => Math.Max(1, new[]
    {
        _stats?.OpenRequestsCount ?? 0,
        _stats?.ActiveBidsCount ?? 0,
        _stats?.CompletedRequestsCount ?? 0,
        _stats?.TotalRequestsCount ?? 0
    }.Max());

    private int MaxContactValue => Math.Max(1, new[]
    {
        _contactSummary?.PendingCount ?? 0,
        _contactSummary?.ApprovedCount ?? 0,
        _contactSummary?.RejectedCount ?? 0,
        _contactSummary?.CallbackPendingCount ?? 0
    }.Max());

    private void GoToCreateRequest() => Nav.NavigateTo("/user/create-request");
    private void GoToMyRequests() => Nav.NavigateTo("/user/my-requests");
    private void GoToServiceOrders() => Nav.NavigateTo("/user/service-orders");
    private void GoToProfiles() => Nav.NavigateTo("/profiles/search");
    private void GoToContactRequests() => Nav.NavigateTo("/contact-requests");
    private void GoToMarketplace() => Nav.NavigateTo("/marketplace/search");

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.IsAuthenticatedAsync())
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (!await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ServiceCustomer))
        {
            await Redirector.RedirectToDashboardAsync();
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _stats = await RequestsClient.GetDashboardStatsAsync();
            _contactSummary = await ContactClient.GetSummaryAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
