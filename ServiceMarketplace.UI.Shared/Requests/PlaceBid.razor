@using ServiceMarketplace.Application.DTOs
@inject BidsApiClient BidsClient

<div class="card mt-3">
    <div class="card-body">
        <h5 class="mb-3">Place Bid</h5>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        @if (!string.IsNullOrWhiteSpace(_success))
        {
            <div class="alert alert-success" role="alert">@_success</div>
        }

        <div class="row g-2 mb-3">
            <div class="col-12 col-md-4">
                <label class="form-label">Amount</label>
                <input class="form-control" type="number" step="0.01" @bind="_model.Amount" @bind:event="oninput" disabled="@_busy" />
            </div>
            <div class="col-12 col-md-8">
                <label class="form-label">Proposed date/time</label>
                <input class="form-control"
                       type="datetime-local"
                       value="@ProposedLocal"
                       @onchange="OnProposedChanged"
                       disabled="@_busy" />
            </div>
        </div>

        <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Submitting...</span>
            }
            else
            {
                <span>Submit Bid</span>
            }
        </button>
    </div>
</div>

@code {
    [Parameter]
    public Guid ServiceRequestId { get; set; }

    private readonly CreateBidDto _model = new();
    private bool _busy;
    private string? _error;
    private string? _success;

    private DateTime _proposed = DateTime.Now.AddHours(2);

    private string ProposedLocal
    {
        get => _proposed.ToString("yyyy-MM-ddTHH:mm");
        set
        {
            if (DateTime.TryParse(value, out var parsed))
                _proposed = parsed;
        }
    }

    protected override void OnParametersSet()
    {
        _model.ServiceRequestId = ServiceRequestId;
    }

    private void OnProposedChanged(ChangeEventArgs e)
    {
        var s = e.Value?.ToString();
        if (!string.IsNullOrWhiteSpace(s) && DateTime.TryParse(s, out var parsed))
            _proposed = parsed;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _success = null;

        if (_model.Amount <= 0)
        {
            _error = "Bid amount must be greater than 0.";
            return;
        }

        _model.ProposedDateTime = _proposed;

        _busy = true;
        try
        {
            await BidsClient.PlaceBidAsync(_model);
            _success = "Bid placed.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
