@using Microsoft.AspNetCore.Components.Authorization
@using ServiceMarketplace.UI.Shared.Auth

<AuthorizeView>
    <Authorizing>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">ServiceMarketplace</a>
                <span class="text-muted small ms-auto">Loading...</span>
            </div>
        </div>
    </Authorizing>

    <Authorized>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">ServiceMarketplace</a>
            </div>
        </div>

        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

        <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
            <nav class="flex-column">
                <!-- Home Link (visible to all authenticated users) -->
                <div class="nav-item px-3">
                    <HomeDashboardLink />
                </div>

                <!-- Role-Based Navigation Links -->
                <RoleNavLinks />
            </nav>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="top-row ps-3 navbar navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="">ServiceMarketplace</a>
            </div>
        </div>

        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />

        <div class="nav-scrollable collapse" onclick="document.querySelector('.navbar-toggler').click()">
            <nav class="flex-column">
                <!-- Login/Register Links (visible to unauthenticated users) -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/login" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-box-arrow-in-right" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/register" Match="NavLinkMatch.Prefix">
                        <span class="bi bi-person-plus" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
            </nav>
        </div>
    </NotAuthorized>
</AuthorizeView>
