@page "/admin/audit-logs"
@using ServiceMarketplace.Application.DTOs
@using ServiceMarketplace.UI.Shared.Admin
@using ServiceMarketplace.UI.Shared.Auth
@inject AuditLogsApiClient AuditLogsClient
@inject NavigationManager Nav
@inject AuthState AuthState

<PageTitle>Audit Logs - Admin</PageTitle>

<div class="container py-4">
    <h2 class="mb-4">Audit Logs</h2>

    <AuthorizeView Roles="@RoleNames.Admin">
        <Authorized>
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger" role="alert">
                    <strong>Error:</strong> @_error
                </div>
            }

            <!-- Filters -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Filters</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <!-- User ID Filter -->
                        <div class="col-md-4">
                            <label class="form-label">User ID</label>
                            <input type="text" class="form-control" @bind="_filterUserId" placeholder="Filter by User ID" />
                        </div>

                        <!-- Event Type Filter -->
                        <div class="col-md-4">
                            <label class="form-label">Event Type</label>
                            <select class="form-select" @bind="_filterEventType">
                                <option value="">All Events</option>
                                @foreach (var eventType in _eventTypes)
                                {
                                    <option value="@eventType">@eventType</option>
                                }
                            </select>
                        </div>

                        <!-- Role Filter -->
                        <div class="col-md-4">
                            <label class="form-label">Role</label>
                            <select class="form-select" @bind="_filterRole">
                                <option value="">All Roles</option>
                                @foreach (var role in _roles)
                                {
                                    <option value="@role">@role</option>
                                }
                            </select>
                        </div>

                        <!-- Start Date Filter -->
                        <div class="col-md-4">
                            <label class="form-label">Start Date</label>
                            <input type="date" class="form-control" @bind="_filterStartDate" />
                        </div>

                        <!-- End Date Filter -->
                        <div class="col-md-4">
                            <label class="form-label">End Date</label>
                            <input type="date" class="form-control" @bind="_filterEndDate" />
                        </div>

                        <!-- Page Size -->
                        <div class="col-md-4">
                            <label class="form-label">Results per Page</label>
                            <select class="form-select" @bind="_pageSize">
                                <option value="10">10</option>
                                <option value="20">20</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <button class="btn btn-primary me-2" @onclick="ApplyFiltersAsync" disabled="@_loading">
                            @if (_loading)
                            {
                                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                            }
                            Apply Filters
                        </button>
                        <button class="btn btn-secondary" @onclick="ClearFiltersAsync" disabled="@_loading">
                            Clear Filters
                        </button>
                    </div>
                </div>
            </div>

            <!-- Results Summary -->
            @if (_response != null)
            {
                <div class="mb-3">
                    <p class="mb-0">
                        Showing <strong>@_response.Items.Count</strong> of <strong>@_response.TotalCount</strong> records
                        (Page @_response.Page of @_response.TotalPages)
                    </p>
                </div>
            }

            <!-- Audit Logs Table -->
            @if (_loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">Loading audit logs...</p>
                </div>
            }
            else if (_response != null && _response.Items.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>Timestamp (UTC)</th>
                                <th>Event Type</th>
                                <th>User ID</th>
                                <th>Role</th>
                                <th>Session ID</th>
                                <th>IP Address</th>
                                <th>User Agent</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var log in _response.Items)
                            {
                                <tr>
                                    <td class="text-nowrap">@log.TimestampUtc.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                    <td>
                                        <span class="badge @GetEventBadgeClass(log.EventType)">
                                            @log.EventType
                                        </span>
                                    </td>
                                    <td class="font-monospace small">@TruncateString(log.UserId, 12)</td>
                                    <td>@log.Role</td>
                                    <td class="font-monospace small">@TruncateString(log.SessionId, 12)</td>
                                    <td>@log.IpAddress</td>
                                    <td class="small">@TruncateString(log.UserAgent, 40)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <nav aria-label="Audit log pagination">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(_response.HasPreviousPage ? "" : "disabled")">
                            <button class="page-link" @onclick="() => GoToPageAsync(1)" disabled="@(!_response.HasPreviousPage)">
                                First
                            </button>
                        </li>
                        <li class="page-item @(_response.HasPreviousPage ? "" : "disabled")">
                            <button class="page-link" @onclick="() => GoToPageAsync(_response.Page - 1)" disabled="@(!_response.HasPreviousPage)">
                                Previous
                            </button>
                        </li>

                        @for (int i = Math.Max(1, _response.Page - 2); i <= Math.Min(_response.TotalPages, _response.Page + 2); i++)
                        {
                            var pageNumber = i; // Capture for lambda
                            <li class="page-item @(pageNumber == _response.Page ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPageAsync(pageNumber)">@pageNumber</button>
                            </li>
                        }

                        <li class="page-item @(_response.HasNextPage ? "" : "disabled")">
                            <button class="page-link" @onclick="() => GoToPageAsync(_response.Page + 1)" disabled="@(!_response.HasNextPage)">
                                Next
                            </button>
                        </li>
                        <li class="page-item @(_response.HasNextPage ? "" : "disabled")">
                            <button class="page-link" @onclick="() => GoToPageAsync(_response.TotalPages)" disabled="@(!_response.HasNextPage)">
                                Last
                            </button>
                        </li>
                    </ul>
                </nav>
            }
            else if (_response != null && !_response.Items.Any())
            {
                <div class="alert alert-info" role="alert">
                    <p class="mb-0">No audit logs found matching the current filters.</p>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">Access Denied</h4>
                <p>You do not have permission to view audit logs. This page is only accessible to administrators.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private bool _loading = true;
    private string? _error;
    private AuditLogQueryResponse? _response;

    // Filters
    private string _filterUserId = string.Empty;
    private string _filterEventType = string.Empty;
    private string _filterRole = string.Empty;
    private DateTime? _filterStartDate;
    private DateTime? _filterEndDate;
    private int _pageSize = 20;
    private int _currentPage = 1;

    // Filter options
    private string[] _eventTypes = Array.Empty<string>();
    private string[] _roles = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        // Check if user is authenticated and is Admin
        var isAuthenticated = await AuthState.IsAuthenticatedAsync();
        var role = await AuthState.GetRoleAsync();

        if (!isAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (!string.Equals(role, RoleNames.Admin, StringComparison.Ordinal))
        {
            Nav.NavigateTo("/", forceLoad: false);
            return;
        }

        // Load filter options
        await LoadFilterOptionsAsync();

        // Load initial data
        await LoadAuditLogsAsync();
    }

    private async Task LoadFilterOptionsAsync()
    {
        try
        {
            _eventTypes = await AuditLogsClient.GetEventTypesAsync();
            _roles = await AuditLogsClient.GetRolesAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading filter options: {ex.Message}");
            _eventTypes = new[] { "Login", "Logout", "Registration", "SessionExpired" };
            _roles = new[] { "User", "ServiceProvider", "Admin" };
        }
    }

    private async Task LoadAuditLogsAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            var request = new AuditLogQueryRequest
            {
                UserId = string.IsNullOrWhiteSpace(_filterUserId) ? null : _filterUserId.Trim(),
                EventType = string.IsNullOrWhiteSpace(_filterEventType) ? null : _filterEventType,
                Role = string.IsNullOrWhiteSpace(_filterRole) ? null : _filterRole,
                StartDate = _filterStartDate,
                EndDate = _filterEndDate,
                Page = _currentPage,
                PageSize = _pageSize,
                SortOrder = "desc"
            };

            _response = await AuditLogsClient.QueryAuditLogsAsync(request);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _error = "Access denied. You do not have permission to view audit logs.";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load audit logs: {ex.Message}";
            Console.WriteLine($"Error loading audit logs: {ex}");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFiltersAsync()
    {
        _currentPage = 1; // Reset to first page when filters change
        await LoadAuditLogsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _filterUserId = string.Empty;
        _filterEventType = string.Empty;
        _filterRole = string.Empty;
        _filterStartDate = null;
        _filterEndDate = null;
        _currentPage = 1;
        await LoadAuditLogsAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        if (page < 1 || _response == null || page > _response.TotalPages)
            return;

        _currentPage = page;
        await LoadAuditLogsAsync();
    }

    private string GetEventBadgeClass(string eventType)
    {
        return eventType switch
        {
            "Login" => "bg-success",
            "Logout" => "bg-info",
            "Registration" => "bg-primary",
            "SessionExpired" => "bg-warning text-dark",
            _ => "bg-secondary"
        };
    }

    private string TruncateString(string? value, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "-";

        if (value.Length <= maxLength)
            return value;

        return value.Substring(0, maxLength) + "...";
    }
}
