@page "/user/dashboard"
@using ServiceMarketplace.UI.Shared.Requests
@using ServiceMarketplace.UI.Shared.Auth
@inject NavigationManager Nav
@inject AuthState AuthState

@code {
    private bool _isAuthenticated;
    private string? _role;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthState.IsAuthenticatedAsync();
        _role = await AuthState.GetRoleAsync();
    }
}

<div class="page">
    <h2>User Dashboard</h2>

    @if (!_isAuthenticated)
    {
        <p>Please login to continue.</p>
        <button class="primary" @onclick='@(() => Nav.NavigateTo("/login"))'>Go to Login</button>
    }
    else if (!string.Equals(_role, "User", StringComparison.Ordinal))
    {
        <p>You are not authorized.</p>
    }
    else
    {
        <CreateServiceRequest />
    }
</div>