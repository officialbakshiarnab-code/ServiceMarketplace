@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using ServiceMarketplace.Application.Constants
@using ServiceMarketplace.UI.Shared.Auth
@inject AuthState AuthState

<div class="nav-item px-3">
    <NavLink class="nav-link" href="/notifications" Match="NavLinkMatch.Prefix">
        <span class="bi bi-bell" aria-hidden="true"></span> Notifications
    </NavLink>
</div>

@if (_hasServiceCustomerCapability)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/user/create-request" Match="NavLinkMatch.Prefix">
            <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Create Request
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/user/my-requests" Match="NavLinkMatch.Prefix">
            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> My Requests
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/user/service-orders" Match="NavLinkMatch.Prefix">
            <span class="bi bi-clipboard-check" aria-hidden="true"></span> Service Orders
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/user/service-packages" Match="NavLinkMatch.Prefix">
            <span class="bi bi-grid" aria-hidden="true"></span> Service Packages
        </NavLink>
    </div>
}

@if (_hasProductBuyerCapability)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/products" Match="NavLinkMatch.Prefix">
            <span class="bi bi-bag" aria-hidden="true"></span> Products
        </NavLink>
    </div>
}

@if (_hasProductSellerCapability)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/seller/products" Match="NavLinkMatch.Prefix">
            <span class="bi bi-box-seam" aria-hidden="true"></span> My Products
        </NavLink>
    </div>
}
else if (_hasProductBuyerCapability)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/account/seller-application" Match="NavLinkMatch.Prefix">
            <span class="bi bi-shop" aria-hidden="true"></span> Become Seller
        </NavLink>
    </div>
}

@if (_hasServiceProviderCapability)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/provider/available-requests" Match="NavLinkMatch.Prefix">
            <span class="bi bi-search" aria-hidden="true"></span> Available Requests
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/provider/my-bids" Match="NavLinkMatch.Prefix">
            <span class="bi bi-bookmark-check" aria-hidden="true"></span> My Bids
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/provider/service-orders" Match="NavLinkMatch.Prefix">
            <span class="bi bi-clipboard-check" aria-hidden="true"></span> Service Orders
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/provider/service-packages" Match="NavLinkMatch.Prefix">
            <span class="bi bi-tags" aria-hidden="true"></span> My Packages
        </NavLink>
    </div>
}

@if (_isAdmin)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/admin/seller-applications" Match="NavLinkMatch.Prefix">
            <span class="bi bi-shop-window" aria-hidden="true"></span> Seller Applications
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/admin/order-reviews" Match="NavLinkMatch.Prefix">
            <span class="bi bi-shield-check" aria-hidden="true"></span> Review Moderation
        </NavLink>
    </div>
}

@code {
    private bool _hasServiceCustomerCapability;
    private bool _hasServiceProviderCapability;
    private bool _hasProductBuyerCapability;
    private bool _hasProductSellerCapability;
    private bool _isAdmin;

    protected override async Task OnInitializedAsync()
    {
        _hasServiceCustomerCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ServiceCustomer);
        _hasServiceProviderCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ServiceProvider);
        _hasProductBuyerCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ProductBuyer);
        _hasProductSellerCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ProductSeller);
        _isAdmin = await AuthState.HasRoleAsync(RoleNames.Admin);
    }
}
