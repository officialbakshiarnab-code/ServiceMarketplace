@page "/user/dashboard"
@using ServiceMarketplace.UI.Shared.Auth
@inject NavigationManager Nav
@inject AuthState AuthState
@inject AuthRedirector Redirector

@code {
    private bool _isAuthenticated;
    private string? _role;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthState.IsAuthenticatedAsync();
        _role = await AuthState.GetRoleAsync();

        Console.WriteLine($"[UserDashboard] Auth: {_isAuthenticated}, Role: {_role}");

        if (!_isAuthenticated)
        {
            Console.WriteLine("[UserDashboard] Not authenticated, redirecting to login");
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (string.Equals(_role, RoleNames.Provider, StringComparison.Ordinal))
        {
            Console.WriteLine("[UserDashboard] ServiceProvider detected, redirecting");
            await Redirector.RedirectToDashboardAsync();
        }
    }

    private void GoToCreateRequest() => Nav.NavigateTo("/user/create-request");
    private void GoToMyRequests() => Nav.NavigateTo("/user/my-requests");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User Dashboard</h2>
        <LogoutButton />
    </div>

    <AuthorizeView Roles="@RoleNames.User">
        <Authorized>
            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Quick Actions</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <button class="btn btn-lg btn-primary" type="button" @onclick="GoToCreateRequest">
                                    <i class="bi bi-plus-circle me-2"></i>
                                    Create New Service Request
                                </button>
                                <button class="btn btn-lg btn-outline-primary" type="button" @onclick="GoToMyRequests">
                                    <i class="bi bi-list-ul me-2"></i>
                                    View My Requests
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="mb-0">Recent Activity</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">No recent activity. Create your first service request to get started!</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Stats</h5>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <h6 class="text-muted">Open Requests</h6>
                                <h3 class="mb-0">0</h3>
                            </div>
                            <div class="mb-3">
                                <h6 class="text-muted">Active Bids</h6>
                                <h3 class="mb-0">0</h3>
                            </div>
                            <div>
                                <h6 class="text-muted">Completed</h6>
                                <h3 class="mb-0">0</h3>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning" role="alert">
                <strong>Unauthorized Access</strong>
                <p class="mb-0">You do not have permission to view this page. Redirecting...</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
