@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Routing
@using ServiceMarketplace.Application.Constants
@using ServiceMarketplace.UI.Shared.Auth
@implements IDisposable
@inject AuthState AuthState
@inject NavigationManager Navigation

<div class="nav-section-label">@ActiveModeLabel</div>

@if (_canUseUserMode && _canUseProviderMode)
{
    <div class="nav-mode-switch px-3" @onclick:stopPropagation="true">
        <button type="button"
                class="nav-mode-option @GetModeClass(NavMode.User)"
                aria-pressed="@(_activeMode == NavMode.User)"
                title="Show customer and buyer tools"
                @onclick="() => SetMode(NavMode.User)">
            User
        </button>
        <button type="button"
                class="nav-mode-option @GetModeClass(NavMode.Provider)"
                aria-pressed="@(_activeMode == NavMode.Provider)"
                title="Show provider tools"
                @onclick="() => SetMode(NavMode.Provider)">
            Provider
        </button>
    </div>
}

<div class="nav-item px-3">
    <NavLink class="nav-link" href="/profiles/search" Match="NavLinkMatch.Prefix">
        <span class="bi bi-person-lines-fill" aria-hidden="true"></span> Profile Search
    </NavLink>
</div>
<div class="nav-item px-3">
    <NavLink class="nav-link" href="/contact-requests" Match="NavLinkMatch.Prefix">
        <span class="bi bi-telephone-outbound" aria-hidden="true"></span> Contact Requests
    </NavLink>
</div>

@if (_activeMode == NavMode.User)
{
    @if (_hasServiceCustomerCapability)
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/user/create-request" Match="NavLinkMatch.Prefix">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Create Request
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/user/my-requests" Match="NavLinkMatch.Prefix">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> My Requests
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/user/service-orders" Match="NavLinkMatch.Prefix">
                <span class="bi bi-clipboard-check" aria-hidden="true"></span> Service Orders
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/user/service-packages" Match="NavLinkMatch.Prefix">
                <span class="bi bi-grid" aria-hidden="true"></span> Service Packages
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/marketplace/search" Match="NavLinkMatch.Prefix">
                <span class="bi bi-search" aria-hidden="true"></span> Search
            </NavLink>
        </div>
    }

    @if (_hasProductBuyerCapability)
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/products" Match="NavLinkMatch.Prefix">
                <span class="bi bi-bag" aria-hidden="true"></span> Products
            </NavLink>
        </div>
        @if (!_hasServiceCustomerCapability)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/marketplace/search" Match="NavLinkMatch.Prefix">
                    <span class="bi bi-search" aria-hidden="true"></span> Search
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/products/orders" Match="NavLinkMatch.Prefix">
                <span class="bi bi-receipt" aria-hidden="true"></span> Product Orders
            </NavLink>
        </div>
    }

    @if (_hasProductSellerCapability)
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/seller/products" Match="NavLinkMatch.Prefix">
                <span class="bi bi-box-seam" aria-hidden="true"></span> My Products
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/seller/product-orders" Match="NavLinkMatch.Prefix">
                <span class="bi bi-truck" aria-hidden="true"></span> Product Delivery
            </NavLink>
        </div>
    }
    else if (CanApplyToBecomeSeller)
    {
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/account/seller-application" Match="NavLinkMatch.Prefix">
                <span class="bi bi-shop" aria-hidden="true"></span> Become Seller
            </NavLink>
        </div>
    }
}

@if (_activeMode == NavMode.Provider && _hasServiceProviderCapability)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/provider/available-requests" Match="NavLinkMatch.Prefix">
            <span class="bi bi-search" aria-hidden="true"></span> Available Requests
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/provider/my-bids" Match="NavLinkMatch.Prefix">
            <span class="bi bi-bookmark-check" aria-hidden="true"></span> My Bids
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/provider/service-orders" Match="NavLinkMatch.Prefix">
            <span class="bi bi-clipboard-check" aria-hidden="true"></span> Provider Orders
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/provider/service-packages" Match="NavLinkMatch.Prefix">
            <span class="bi bi-tags" aria-hidden="true"></span> My Packages
        </NavLink>
    </div>
}

@if (_isAdmin)
{
    <div class="nav-section-label">Admin</div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/admin/seller-applications" Match="NavLinkMatch.Prefix">
            <span class="bi bi-shop-window" aria-hidden="true"></span> Seller Applications
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/admin/order-reviews" Match="NavLinkMatch.Prefix">
            <span class="bi bi-shield-check" aria-hidden="true"></span> Review Moderation
        </NavLink>
    </div>
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/admin/contact-requests" Match="NavLinkMatch.Prefix">
            <span class="bi bi-person-vcard" aria-hidden="true"></span> Contact Review
        </NavLink>
    </div>
}

@code {
    private enum NavMode
    {
        User,
        Provider
    }

    private bool _hasServiceCustomerCapability;
    private bool _hasServiceProviderCapability;
    private bool _hasProductBuyerCapability;
    private bool _hasProductSellerCapability;
    private bool _canUseUserMode;
    private bool _canUseProviderMode;
    private bool _isAdmin;
    private NavMode _activeMode = NavMode.User;

    private string ActiveModeLabel => _activeMode == NavMode.Provider ? "Provider Mode" : "User Mode";
    private bool CanApplyToBecomeSeller => _hasProductBuyerCapability
        && !_hasProductSellerCapability
        && !_hasServiceProviderCapability;

    protected override async Task OnInitializedAsync()
    {
        _hasServiceCustomerCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ServiceCustomer);
        _hasServiceProviderCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ServiceProvider);
        _hasProductBuyerCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ProductBuyer);
        _hasProductSellerCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ProductSeller);
        _isAdmin = await AuthState.HasRoleAsync(RoleNames.Admin);

        _canUseUserMode = _hasServiceCustomerCapability || _hasProductBuyerCapability || _hasProductSellerCapability;
        _canUseProviderMode = _hasServiceProviderCapability;

        _activeMode = GetInitialMode();
        Navigation.LocationChanged += HandleLocationChanged;
    }

    private NavMode GetInitialMode()
    {
        var routeMode = GetRouteMode(Navigation.Uri);

        if (routeMode == NavMode.Provider && _canUseProviderMode)
            return NavMode.Provider;

        if (routeMode == NavMode.User && _canUseUserMode)
            return NavMode.User;

        if (_canUseUserMode)
            return NavMode.User;

        return _canUseProviderMode ? NavMode.Provider : NavMode.User;
    }

    private void SetMode(NavMode mode)
    {
        if (mode == NavMode.Provider && !_canUseProviderMode)
            return;

        if (mode == NavMode.User && !_canUseUserMode)
            return;

        _activeMode = mode;

        var target = mode == NavMode.Provider ? "/provider/dashboard" : "/user/dashboard";
        Navigation.NavigateTo(target, forceLoad: false);
    }

    private string GetModeClass(NavMode mode) => _activeMode == mode ? "active" : string.Empty;

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var routeMode = GetRouteMode(args.Location);

        if (routeMode is null)
            return;

        if (routeMode == NavMode.Provider && !_canUseProviderMode)
            return;

        if (routeMode == NavMode.User && !_canUseUserMode)
            return;

        if (_activeMode == routeMode)
            return;

        _activeMode = routeMode.Value;
        _ = InvokeAsync(StateHasChanged);
    }

    private NavMode? GetRouteMode(string uri)
    {
        var relativeUri = Navigation.ToBaseRelativePath(uri);

        if (relativeUri.StartsWith("provider/", StringComparison.OrdinalIgnoreCase))
            return NavMode.Provider;

        if (relativeUri.StartsWith("user/", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("products", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("marketplace/", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("account/seller-application", StringComparison.OrdinalIgnoreCase)
            || relativeUri.StartsWith("seller/", StringComparison.OrdinalIgnoreCase))
        {
            return NavMode.User;
        }

        return null;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
