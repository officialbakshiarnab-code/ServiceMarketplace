@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Logging
@using ServiceMarketplace.UI.Shared.Auth

<AuthorizeView>
    <Authorized>
        <div class="nav-item px-3">
            <button type="button" class="nav-link btn btn-link text-danger" @onclick="HandleLogoutAsync" disabled="@_isBusy" title="Sign out">
                @if (_isBusy)
                {
                    <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                    <span>Signing out...</span>
                }
                else
                {
                    <span class="bi bi-box-arrow-right me-1" aria-hidden="true"></span>
                    <span>Sign Out</span>
                }
            </button>
        </div>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>
    /// Additional CSS classes to apply to the button.
    /// </summary>
    [Parameter]
    public string? CssClass { get; set; }

    [Inject]
    public required SafeLogoutService LogoutService { get; set; }

    [Inject]
    public required NavigationManager Nav { get; set; }

    [Inject]
    public required ILogger<LogoutButton> Logger { get; set; }

    private bool _isBusy;

    /// <summary>
    /// Handles logout process with guaranteed audit trail:
    /// 
    /// STEP 1: Call /api/auth/logout endpoint (BEFORE clearing tokens)
    ///         - Requires valid JWT for authentication
    ///         - Creates NEW AuditLogs row with EventType="Logout"
    ///         - Records TimestampUtc, UserId, Role, SessionId, IpAddress, UserAgent
    /// 
    /// STEP 2: Clear JWT from local storage
    ///         - Removes authentication token
    /// 
    /// STEP 3: Update authentication state
    ///         - Notifies Blazor to re-evaluate auth state
    ///         - User becomes unauthenticated
    /// 
    /// STEP 4: Redirect to login page
    ///         - Force reload to clear any cached state
    /// 
    /// CRITICAL: API call MUST happen BEFORE token removal to ensure audit record is created.
    /// If API call fails, logout still succeeds locally for user experience.
    /// </summary>
    private async Task HandleLogoutAsync()
    {
        if (_isBusy)
            return; // Prevent concurrent logouts

        _isBusy = true;
        try
        {
            Logger.LogInformation("[LogoutButton] Starting logout sequence");

            // SafeLogoutService handles the complete logout sequence:
            // 1. API call (creates audit record)
            // 2. Clear token
            // 3. Clear auth state
            await LogoutService.LogoutAsync();

            Logger.LogInformation("[LogoutButton] Logout sequence completed, redirecting to login");
            
            // Navigate after logout is complete
            Nav.NavigateTo("/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[LogoutButton] Error during logout: {Error}", ex.Message);
            
            // Even if logout fails, still navigate to login
            // This ensures user can always log out from UI perspective
            Logger.LogInformation("[LogoutButton] Forcing navigation to /login despite error");
            Nav.NavigateTo("/login", forceLoad: true);
        }
        finally
        {
            _isBusy = false;
        }
    }
}
