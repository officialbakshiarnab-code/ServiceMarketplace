@using ServiceMarketplace.Application.DTOs
@inject RequestsApiClient RequestsClient

<div class="card mt-3">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="mb-0">Open Requests</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadAsync" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        @if (_loading)
        {
            <p class="text-muted mb-0">Loading...</p>
        }
        else if (_items.Count == 0)
        {
            <p class="text-muted mb-0">No items.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var r in _items)
                {
                    <div class="list-group-item">
                        <div class="d-flex w-100 justify-content-between">
                            <h6 class="mb-1">@r.Title</h6>
                            <small class="text-muted">@r.Status</small>
                        </div>
                        <p class="mb-1 text-muted">@r.Description</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    private bool _loading;
    private string? _error;
    private List<ServiceRequestDto> _items = [];

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            // NOTE: API doesn't expose "my requests" yet. Best-effort fallback using existing endpoint.
            _items = await RequestsClient.OpenAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }
}
