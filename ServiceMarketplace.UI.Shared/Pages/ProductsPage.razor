@page "/products"
@using ServiceMarketplace.Application.Constants
@using ServiceMarketplace.Application.DTOs
@using ServiceMarketplace.Domain.Enums
@using ServiceMarketplace.UI.Shared.Auth
@using ServiceMarketplace.UI.Shared.Requests
@inject ProductListingsApiClient ProductsClient
@inject ProductDeliveryOrdersApiClient ProductDeliveryOrdersClient
@inject ProductCatalogApiClient ProductCatalogClient
@inject ServiceCatalogApiClient ServiceCatalogClient
@inject AuthState AuthState
@inject NavigationManager Nav

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Products</h2>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary" @onclick="GoOrders">My Orders</button>
            <button class="btn btn-link" @onclick="GoBack">Back</button>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <select class="form-select" @bind="_categoryFilter">
                <option value="">All categories</option>
                @foreach (var category in _categories)
                {
                    <option value="@category.Id">@category.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <select class="form-select" @bind="_zoneFilter">
                <option value="">All Kolkata zones</option>
                @foreach (var zone in _zones)
                {
                    <option value="@zone.Id">@zone.DisplayName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <select class="form-select" @bind="_conditionFilter">
                <option value="">Any condition</option>
                <option value="@((int)ProductCondition.New)">New</option>
                <option value="@((int)ProductCondition.LikeNew)">Like new</option>
                <option value="@((int)ProductCondition.Good)">Good</option>
                <option value="@((int)ProductCondition.Fair)">Fair</option>
                <option value="@((int)ProductCondition.NeedsRepair)">Needs repair</option>
            </select>
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-primary" @onclick="LoadProductsAsync" disabled="@_loading">Filter</button>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(_success))
    {
        <div class="alert alert-success" role="alert">@_success</div>
    }

    @if (_loading)
    {
        <p class="text-muted mb-0">Loading...</p>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">@_error</div>
    }
    else if (_products.Count == 0)
    {
        <div class="card">
            <div class="card-body">
                <p class="text-muted mb-0">No active products are available for this selection.</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var product in _products)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100">
                        @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" class="card-img-top" alt="@product.Title" style="height: 180px; object-fit: cover;" />
                        }
                        <div class="card-body">
                            <div class="d-flex justify-content-between gap-3">
                                <div>
                                    <h5 class="mb-1">@product.Title</h5>
                                    <p class="small text-muted mb-2">@product.ProductCategoryName | @product.ServiceZoneName</p>
                                </div>
                                <div class="fw-bold text-nowrap">$@product.Price.ToString("0.00")</div>
                            </div>
                            <p class="mb-2">@product.Description</p>
                            <p class="small mb-2">
                                <span class="badge @(product.IsUsed ? "bg-warning text-dark" : "bg-success")">@product.ConditionLabel</span>
                                @if (product.IsUsed && product.PurchaseYear.HasValue)
                                {
                                    <span class="text-muted ms-1">Purchased @product.PurchaseYear</span>
                                }
                            </p>
                            @if (product.IsUsed)
                            {
                                <div class="border-start ps-2 mb-2">
                                    <p class="small mb-1"><strong>Condition:</strong> @product.ConditionNotes</p>
                                    <p class="small mb-1"><strong>Seller inspection:</strong> @product.InspectionChecklist</p>
                                    <p class="small text-muted mb-0">
                                        Original bill: @(product.HasOriginalBill ? "Yes" : "No") |
                                        Warranty: @(product.HasWarranty ? "Yes" : "No")
                                    </p>
                                </div>
                            }
                            @if (product.IsUsed && product.UsedInspectionPrompts.Count > 0)
                            {
                                <details class="small mb-2">
                                    <summary>Inspection guidance</summary>
                                    <ul class="mb-0 mt-1 ps-3">
                                        @foreach (var prompt in product.UsedInspectionPrompts)
                                        {
                                            <li>@prompt</li>
                                        }
                                    </ul>
                                </details>
                            }
                            <p class="small text-muted mb-0">@product.StoreName | @product.StockQuantity in stock</p>
                            <div class="mt-3">
                                <button class="btn btn-sm btn-primary" @onclick="() => OpenOrderForm(product)" disabled="@_busy">Order Delivery</button>
                            </div>
                            @if (_orderingProductId == product.Id)
                            {
                                <div class="border-top mt-3 pt-3">
                                    <div class="row g-2">
                                        <div class="col-6">
                                            <label class="form-label small">Quantity</label>
                                            <input class="form-control form-control-sm" type="number" min="1" max="@product.StockQuantity" @bind="_orderForm.Quantity" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">Recipient</label>
                                            <input class="form-control form-control-sm" @bind="_orderForm.DeliveryRecipientName" maxlength="150" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">Phone</label>
                                            <input class="form-control form-control-sm" @bind="_orderForm.DeliveryPhoneNumber" maxlength="20" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">Delivery Address</label>
                                            <textarea class="form-control form-control-sm" rows="2" @bind="_orderForm.DeliveryAddress" maxlength="500"></textarea>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">City</label>
                                            <input class="form-control form-control-sm" @bind="_orderForm.DeliveryCity" maxlength="100" />
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label small">State</label>
                                            <input class="form-control form-control-sm" @bind="_orderForm.DeliveryState" maxlength="100" />
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">Zone</label>
                                            <select class="form-select form-select-sm" @bind="_orderZoneValue">
                                                <option value="">No zone selected</option>
                                                @foreach (var zone in _zones)
                                                {
                                                    <option value="@zone.Id">@zone.DisplayName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-12">
                                            <label class="form-label small">Notes</label>
                                            <textarea class="form-control form-control-sm" rows="2" @bind="_orderForm.BuyerNotes" maxlength="1000"></textarea>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-2 mt-3">
                                        <button class="btn btn-sm btn-success" @onclick="SubmitOrderAsync" disabled="@_busy">Submit Order</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="CloseOrderForm" disabled="@_busy">Cancel</button>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _success;
    private string _categoryFilter = string.Empty;
    private string _zoneFilter = string.Empty;
    private string _conditionFilter = string.Empty;
    private string _orderZoneValue = string.Empty;
    private Guid? _orderingProductId;
    private List<ProductListingDto> _products = [];
    private List<ProductCategoryDto> _categories = [];
    private List<ServiceZoneDto> _zones = [];
    private CreateProductDeliveryOrderDto _orderForm = new();

    protected override async Task OnInitializedAsync()
    {
        if (!await AuthState.IsAuthenticatedAsync() ||
            !await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ProductBuyer))
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        try
        {
            _categories = await ProductCatalogClient.GetCategoriesAsync();
            _zones = await ServiceCatalogClient.GetZonesAsync();
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            _error = ErrorMessageFormatter.ToFriendlyMessage(ex, "Unable to load products.");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadProductsAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _products = await ProductsClient.GetActiveAsync(ParseGuid(_categoryFilter), ParseGuid(_zoneFilter), ParseCondition(_conditionFilter));
        }
        catch (Exception ex)
        {
            _error = ErrorMessageFormatter.ToFriendlyMessage(ex, "Unable to load products.");
        }
        finally
        {
            _loading = false;
        }
    }

    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;

    private static ProductCondition? ParseCondition(string value)
    {
        return int.TryParse(value, out var raw) && Enum.IsDefined(typeof(ProductCondition), raw)
            ? (ProductCondition)raw
            : null;
    }

    private void OpenOrderForm(ProductListingDto product)
    {
        _error = null;
        _success = null;
        _orderingProductId = product.Id;
        _orderForm = new CreateProductDeliveryOrderDto
        {
            ProductListingId = product.Id,
            Quantity = 1,
            DeliveryCity = "Kolkata",
            DeliveryState = "West Bengal",
            ServiceZoneId = product.ServiceZoneId ?? ParseGuid(_zoneFilter) ?? _zones.FirstOrDefault()?.Id
        };
        _orderZoneValue = _orderForm.ServiceZoneId?.ToString() ?? string.Empty;
    }

    private void CloseOrderForm()
    {
        _orderingProductId = null;
        _orderForm = new CreateProductDeliveryOrderDto();
        _orderZoneValue = string.Empty;
    }

    private async Task SubmitOrderAsync()
    {
        _busy = true;
        _error = null;
        _success = null;
        try
        {
            _orderForm.ServiceZoneId = ParseGuid(_orderZoneValue);
            var order = await ProductDeliveryOrdersClient.CreateAsync(_orderForm);
            _success = $"Delivery order {order.StatusLabel.ToLowerInvariant()} for {order.ProductTitle}.";
            CloseOrderForm();
            await LoadProductsAsync();
        }
        catch (Exception ex)
        {
            _error = ErrorMessageFormatter.ToFriendlyMessage(ex, "Unable to submit product delivery order.");
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/user/dashboard");

    private void GoOrders() => Nav.NavigateTo("/products/orders");
}
