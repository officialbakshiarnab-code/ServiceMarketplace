@page "/login"
@using System.ComponentModel.DataAnnotations
@using Microsoft.Extensions.Logging
@using ServiceMarketplace.UI.Shared.Auth
@inject AuthApiClient AuthApi
@inject TokenAuthenticationStateProvider AuthStateProvider
@inject AuthRedirector Redirector
@inject NavigationManager Nav
@inject ILogger<Login> Logger

<PageTitle>Login</PageTitle>

<div class="container py-4" style="max-width: 520px;">
    <h3 class="mb-3">Login</h3>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="alert alert-danger" role="alert">
            <strong>Error:</strong> @_error
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="HandleLoginAsync">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="mb-3">
            <label class="form-label">Email</label>
            <InputText class="form-control" @bind-Value="_model.Email" placeholder="Email" disabled="@_busy" />
            <ValidationMessage For="@(() => _model.Email)" />
        </div>

        <div class="mb-3">
            <label class="form-label">Password</label>
            <input type="password" class="form-control" @bind="_model.Password" placeholder="Password" disabled="@_busy" />
            <ValidationMessage For="@(() => _model.Password)" />
        </div>

        <button type="submit" class="btn btn-primary w-100 mb-2" disabled="@_busy">
            @if (_busy)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Logging in...</span>
            }
            else
            {
                <span>Login</span>
            }
        </button>
        <button type="button" class="btn btn-link w-100" @onclick="GoToRegister" disabled="@_busy">
            Don't have an account? Register here
        </button>
    </EditForm>
</div>

@code {
    private readonly LoginModel _model = new();
    private readonly SubmissionGuard _submissionGuard = new();
    private bool _busy;
    private string? _error;

    /// <summary>
    /// Handles user login with graceful error handling:
    /// 1. Check SubmissionGuard - ensure this is not a duplicate request
    /// 2. Create LoginRequest DTO matching API contract (Email, Password)
    /// 3. Call AuthApiClient.LoginAsync (sends POST /api/auth/login)
    /// 4. On success: JWT stored by AuthApiClient → notify auth provider → redirect by role
    /// 5. On failure: displays user-friendly error message (never throws)
    /// 
    /// GRACEFUL ERROR HANDLING:
    /// - AuthApiClient never throws exceptions
    /// - Returns LoginResult with success flag and optional error message
    /// - UI displays errors without crashing
    /// 
    /// DUPLICATE PREVENTION:
    /// - SubmissionGuard tracks login attempts within 30 seconds
    /// - If user clicks login button twice quickly, second click is rejected
    /// - No duplicate API calls reach server
    /// 
    /// REDIRECT GUARANTEE:
    /// - Auth state is updated before redirect is called
    /// - Redirect respects user's complete role set (including "Both" scenarios)
    /// - If user has both User and Provider roles, Provider dashboard is prioritized
    /// </summary>
    private async Task HandleLoginAsync()
    {
        // GUARD: Check if this submission is allowed (prevents duplicate submissions)
        if (!await _submissionGuard.IsAllowedAsync("login"))
        {
            Logger.LogWarning("[Login] Duplicate submission attempt blocked");
            return;
        }

        _error = null;
        _busy = true;

        try
        {
            // Create request DTO with exact property names/types API expects
            var request = new LoginRequest
            {
                Email = _model.Email,
                Password = _model.Password
            };

            Logger.LogInformation("[Login] Sending login request for: {Email}", request.Email);

            // Call AuthApiClient - returns result object (never throws)
            var result = await AuthApi.LoginAsync(request);

            if (!result.Success)
            {
                // Login failed - display user-friendly error message
                _error = result.Error ?? "Login failed. Please try again.";
                Logger.LogWarning("[Login] Login failed: {Error}", _error);
                
                // Reset submission guard on error so user can retry
                await _submissionGuard.ResetAsync("login");
                return;
            }

            Logger.LogInformation("[Login] Login successful, JWT stored in browser storage");

            // Notify Blazor framework to re-read JWT from storage and update auth state
            // This is critical: the redirect MUST happen after this notification
            AuthStateProvider.NotifyAuthenticationStateChanged();
            Logger.LogInformation("[Login] Auth state notification sent to Blazor");

            // Small delay to ensure auth state has been propagated through the component tree
            // This guarantees that Redirector.RedirectToDashboardAsync() will read the updated auth state
            await Task.Delay(50);

            // Reads all role claims from JWT and navigates to appropriate dashboard
            // Logic:
            // - If user has BOTH User and ServiceProvider roles → /provider/dashboard (default to Provider)
            // - If user has ServiceProvider role only → /provider/dashboard
            // - If user has User role only → /user/dashboard
            // - If user has no roles → /user/dashboard (safe default)
            await Redirector.RedirectToDashboardAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private void GoToRegister() => Nav.NavigateTo("/register");

    /// <summary>
    /// View model for login form with client-side validation.
    /// Separate from LoginRequest DTO to avoid coupling UI validation to API contract.
    /// </summary>
    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Email is required")]
        [EmailAddress(ErrorMessage = "Invalid email format")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = string.Empty;
    }
}

