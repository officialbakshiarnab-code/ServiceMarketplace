@page "/user/dashboard"
@using ServiceMarketplace.Application.Constants
@using ServiceMarketplace.Application.DTOs
@using ServiceMarketplace.UI.Shared.Auth
@using ServiceMarketplace.UI.Shared.Requests
@inject NavigationManager Nav
@inject AuthState AuthState
@inject AuthRedirector Redirector
@inject RequestsApiClient RequestsClient

@code {
    private bool _isAuthenticated;
    private bool _hasServiceCustomerCapability;
    private bool _loadingStats = true;
    private string? _statsError;
    private UserDashboardStatsDto? _stats;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthState.IsAuthenticatedAsync();
        _hasServiceCustomerCapability = await AuthState.HasMarketplaceCapabilityAsync(MarketplaceCapabilityConstants.ServiceCustomer);

        Console.WriteLine($"[UserDashboard] Auth: {_isAuthenticated}, ServiceCustomer: {_hasServiceCustomerCapability}");

        if (!_isAuthenticated)
        {
            Console.WriteLine("[UserDashboard] Not authenticated, redirecting to login");
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (!_hasServiceCustomerCapability)
        {
            Console.WriteLine("[UserDashboard] Missing service.customer capability, redirecting");
            await Redirector.RedirectToDashboardAsync();
            return;
        }

        // Load dashboard stats
        await LoadStatsAsync();
    }

    private async Task LoadStatsAsync()
    {
        _loadingStats = true;
        _statsError = null;

        try
        {
            _stats = await RequestsClient.GetDashboardStatsAsync();
            Console.WriteLine($"[UserDashboard] Stats loaded: Open={_stats.OpenRequestsCount}, Bids={_stats.ActiveBidsCount}, Completed={_stats.CompletedRequestsCount}");
        }
        catch (Exception ex)
        {
            _statsError = $"Failed to load stats: {ex.Message}";
            Console.WriteLine($"[UserDashboard] Error loading stats: {ex.Message}");
        }
        finally
        {
            _loadingStats = false;
        }
    }

    /// <summary>
    /// Refresh stats after user performs an action (e.g., creates a request).
    /// Call this from parent component or after navigation back to dashboard.
    /// </summary>
    public async Task RefreshStatsAsync()
    {
        await LoadStatsAsync();
        StateHasChanged();
    }

    private void GoToCreateRequest() => Nav.NavigateTo("/user/create-request");
    private void GoToMyRequests() => Nav.NavigateTo("/user/my-requests");
    private void GoToServiceOrders() => Nav.NavigateTo("/user/service-orders");
    private void GoToProviderApplication() => Nav.NavigateTo("/account/provider-application");
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">User Dashboard</h2>
        <LogoutButton />
    </div>

    <AuthorizeView>
        <Authorized>
            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Quick Actions</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <button class="btn btn-lg btn-primary" type="button" @onclick="GoToCreateRequest">
                                    <i class="bi bi-plus-circle me-2"></i>
                                    Create New Service Request
                                </button>
                                <button class="btn btn-lg btn-outline-primary" type="button" @onclick="GoToMyRequests">
                                    <i class="bi bi-list-ul me-2"></i>
                                    View My Requests
                                </button>
                                <button class="btn btn-lg btn-outline-success" type="button" @onclick="GoToServiceOrders">
                                    <i class="bi bi-clipboard-check me-2"></i>
                                    View Service Orders
                                </button>
                                <button class="btn btn-lg btn-outline-secondary" type="button" @onclick="GoToProviderApplication">
                                    <i class="bi bi-person-check me-2"></i>
                                    Become a Provider
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card mt-3">
                        <div class="card-header">
                            <h5 class="mb-0">Recent Activity</h5>
                        </div>
                        <div class="card-body">
                            <p class="text-muted">No recent activity. Create your first service request to get started!</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card">
                        <div class="card-header">
                            <h5 class="mb-0">Stats</h5>
                        </div>
                        <div class="card-body">
                            @if (_loadingStats)
                            {
                                <div class="text-center py-3">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                    <p class="text-muted small mt-2 mb-0">Loading stats...</p>
                                </div>
                            }
                            else if (!string.IsNullOrWhiteSpace(_statsError))
                            {
                                <div class="alert alert-warning py-2 mb-0" role="alert">
                                    <small>@_statsError</small>
                                </div>
                            }
                            else if (_stats != null)
                            {
                                <div class="mb-3">
                                    <h6 class="text-muted">Open Requests</h6>
                                    <h3 class="mb-0 text-primary">@_stats.OpenRequestsCount</h3>
                                    <small class="text-muted">Currently accepting bids</small>
                                </div>
                                <hr />
                                <div class="mb-3">
                                    <h6 class="text-muted">Active Bids</h6>
                                    <h3 class="mb-0 text-info">@_stats.ActiveBidsCount</h3>
                                    <small class="text-muted">Bids received on open requests</small>
                                </div>
                                <hr />
                                <div class="mb-3">
                                    <h6 class="text-muted">Completed</h6>
                                    <h3 class="mb-0 text-success">@_stats.CompletedRequestsCount</h3>
                                    <small class="text-muted">Service completed or cancelled</small>
                                </div>
                                <hr />
                                <div>
                                    <h6 class="text-muted">Total Requests</h6>
                                    <h3 class="mb-0">@_stats.TotalRequestsCount</h3>
                                    <small class="text-muted">All time</small>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted mb-0">No stats available</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning" role="alert">
                <strong>Unauthorized Access</strong>
                <p class="mb-0">You do not have permission to view this page. Redirecting...</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>
