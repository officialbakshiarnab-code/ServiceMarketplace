@using ServiceMarketplace.Application.DTOs
@inject BidsApiClient BidsClient

<div class="card mt-3">
    <div class="card-body">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h5 class="mb-0">Bids</h5>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadAsync" disabled="@_loading">
                @if (_loading)
                {
                    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                }
                else
                {
                    <span>Refresh</span>
                }
            </button>
        </div>

        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-danger" role="alert">@_error</div>
        }

        @if (_loading)
        {
            <p class="text-muted mb-0">Loading...</p>
        }
        else if (_items.Count == 0)
        {
            <p class="text-muted mb-0">No bids.</p>
        }
        else
        {
            <div class="list-group">
                @foreach (var b in _items)
                {
                    <div class="list-group-item">
                        <div class="d-flex w-100 justify-content-between gap-3">
                            <div>
                                <div>
                                    <span class="badge bg-secondary me-2">#@b.ComparisonRank</span>
                                    <strong>@b.ProviderDisplayName</strong>
                                    @if (!string.IsNullOrWhiteSpace(b.ProviderBusinessName))
                                    {
                                        <span class="text-muted"> | @b.ProviderBusinessName</span>
                                    }
                                </div>
                                <div class="small text-muted mt-1">
                                    Rating: @FormatRating(b.ProviderAverageRating, b.ProviderReviewCount)
                                    @if (b.ProviderHourlyRate.HasValue)
                                    {
                                        <span> | Rate: $@b.ProviderHourlyRate.Value.ToString("0.00")/hr</span>
                                    }
                                    @if (b.EstimatedDurationMinutes.HasValue)
                                    {
                                        <span> | Duration: @b.EstimatedDurationMinutes.Value min</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(b.Message))
                                {
                                    <div class="small mt-1">@b.Message</div>
                                }
                            </div>
                            <div class="text-end">
                                <strong>$@b.Amount.ToString("0.00")</strong>
                                <div class="small text-muted">@b.ProposedDateTime.ToLocalTime().ToString("g")</div>
                                <span class="badge bg-light text-dark">@b.Status</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Guid RequestId { get; set; }

    private bool _loading;
    private string? _error;
    private List<BidDto> _items = [];

    protected override Task OnParametersSetAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        if (RequestId == Guid.Empty)
            return;

        _error = null;
        _loading = true;

        try
        {
            _items = await BidsClient.GetBidsForRequestAsync(RequestId);
        }
        catch (Exception ex)
        {
            _error = ErrorMessageFormatter.ToFriendlyMessage(ex, "Unable to load bids right now.");
            _items = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private static string FormatRating(decimal rating, int count)
    {
        return count == 0
            ? "New provider"
            : $"{rating:0.0} / 5 ({count})";
    }
}
