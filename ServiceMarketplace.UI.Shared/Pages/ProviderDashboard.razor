@page "/provider/dashboard"
@using ServiceMarketplace.UI.Shared.Requests
@using ServiceMarketplace.UI.Shared.Auth
@inject NavigationManager Nav
@inject AuthRedirector Redirector
@inject AuthState AuthState

@code {
    private bool _isAuthenticated;
    private string? _role;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthState.IsAuthenticatedAsync();
        _role = await AuthState.GetRoleAsync();

        if (!_isAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (!string.Equals(_role, RoleNames.Provider, StringComparison.Ordinal))
        {
            await Redirector.RedirectToDashboardAsync();
        }
    }

    private void GoToAvailableRequests()
    {
        Nav.NavigateTo("/provider/available-requests");
    }

    private void GoToMyBids()
    {
        Nav.NavigateTo("/provider/my-bids");
    }
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Provider Dashboard</h2>
        <LogoutButton />
    </div>

    <AuthorizeView Roles="@RoleNames.Provider">
        <Authorized>
            <div class="alert alert-info mb-3" role="alert">
                <strong>Browse & Bid on Service Requests</strong>
                <p class="mb-0">View nearby service requests and place competitive bids.</p>
            </div>

            <div class="row">
                <div class="col-md-8">
                    <div class="card">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">Quick Actions</h5>
                        </div>
                        <div class="card-body">
                            <div class="d-grid gap-2">
                                <button class="btn btn-lg btn-primary" type="button" @onclick="GoToAvailableRequests">
                                    <i class="bi bi-search me-2"></i>
                                    Browse Available Requests
                                </button>
                                <button class="btn btn-lg btn-outline-primary" type="button" @onclick="GoToMyBids">
                                    <i class="bi bi-bookmark-check me-2"></i>
                                    View My Bids
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning" role="alert">
                <strong>Unauthorized Access</strong>
                <p class="mb-0">You do not have permission to view this page. Redirecting...</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

