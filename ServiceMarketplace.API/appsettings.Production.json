{
  "Cors": {
    "AllowedOrigins": [
      "https://yourdomain.com",
      "https://www.yourdomain.com"
    ]
  },
  "Security": {
    "EnforceHttps": true,
    "UseHsts": true,
    "HstsMaxAgeSeconds": 31536000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "ServiceMarketplace": "Information"
    }
  }
}
