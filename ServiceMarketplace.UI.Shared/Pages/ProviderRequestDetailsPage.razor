@page "/provider/requests/{RequestId:guid}"
@using ServiceMarketplace.Application.DTOs
@using ServiceMarketplace.Domain.Enums
@using ServiceMarketplace.UI.Shared.Auth
@using ServiceMarketplace.UI.Shared.Requests
@inject RequestsApiClient RequestsClient
@inject NavigationManager Nav
@inject AuthState AuthState

@code {
    [Parameter]
    public Guid RequestId { get; set; }

    private bool _isAuthenticated;
    private string? _role;
    private bool _loading = true;
    private string? _error;
    private ServiceRequestDto? _request;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await AuthState.IsAuthenticatedAsync();
        _role = await AuthState.GetRoleAsync();

        if (!_isAuthenticated)
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        if (!string.Equals(_role, RoleNames.Provider, StringComparison.Ordinal))
        {
            Nav.NavigateTo("/provider/dashboard", forceLoad: false);
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        _loading = true;

        try
        {
            // Use GetRequestDetailsAsync for ServiceProvider role - calls GET /api/requests/{id}/details
            _request = await RequestsClient.GetRequestDetailsAsync(RequestId);
        }
        catch (Exception ex)
        {
            _error = ErrorMessageFormatter.ToFriendlyMessage(ex, "Unable to load the request right now.");
        }
        finally
        {
            _loading = false;
        }
    }
}

<div class="container py-4">
    <button class="btn btn-link px-0 mb-3" @onclick="GoBack">Back to Available Requests</button>

    <AuthorizeView Roles="@RoleNames.Provider">
        <Authorized>
            @if (_loading)
            {
                <p class="text-muted mb-0">Loading...</p>
            }
            else if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="alert alert-danger" role="alert">@_error</div>
            }
            else if (_request == null)
            {
                <p class="text-muted mb-0">Request not found.</p>
            }
            else
            {
                <div class="row">
                    <div class="col-md-8">
                        <div class="card mb-3">
                            <div class="card-body">
                                <h3 class="mb-2">@_request.Title</h3>
                                <p class="text-muted">@_request.Description</p>

                                <div class="row g-2 mb-3">
                                    <div class="col-12 col-md-6">
                                        <strong>Category:</strong> @_request.Category
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <strong>Location:</strong> @_request.Location
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-12 col-md-6">
                                        <strong>Status:</strong>
                                        <span class="badge bg-info">@GetStatusLabel()</span>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <strong>Bids:</strong> @_request.BidCount
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (_request.Status == ServiceRequestStatus.Open)
                        {
                            <PlaceBid ServiceRequestId="RequestId" />
                        }
                        else
                        {
                            <div class="card">
                                <div class="card-body">
                                    <p class="text-muted mb-0">This request is no longer open for bidding.</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-warning" role="alert">
                <strong>Unauthorized Access</strong>
                <p class="mb-0">You do not have permission to access this page.</p>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@code {
    private void GoBack() => Nav.NavigateTo("/provider/available-requests");

    private string GetStatusLabel()
    {
        if (_request == null) return "Unknown";
        return _request.Status switch
        {
            ServiceRequestStatus.Open => "Open",
            ServiceRequestStatus.Accepted => "Accepted",
            ServiceRequestStatus.Closed => "Closed",
            _ => "Unknown"
        };
    }
}
